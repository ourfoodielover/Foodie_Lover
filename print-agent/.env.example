# ── Foodie Lover Print Agent — configuration ────────────────────────────────
# Copy this file to .env and fill in your values.

# Base URL of the deployed Foodie Lover app (no trailing slash)
APP_BASE_URL=https://your-restaurant.example.com

# Restaurant ID (matches NEXT_PUBLIC_RESTAURANT_ID in the web app)
RESTAURANT_ID=rest_default

# Shared secret — must match PRINT_AGENT_KEY in the web app's environment
PRINT_AGENT_KEY=change-me-to-a-long-random-string

# How often to poll for new print jobs (milliseconds)
POLL_INTERVAL_MS=4000

# ── Printer connection mode ────────────────────────────────────────────────────
# usb     → printer is connected to this laptop/PC via USB cable  ← USE THIS
# network → printer has its own Ethernet/Wi-Fi connection (needs PRINTER_IP)
PRINTER_TYPE=usb

# ── USB mode (PRINTER_TYPE=usb) ───────────────────────────────────────────────
# Windows: the exact printer name shown in Windows "Devices & Printers"
#   1. Plug in the CN811 via USB — Windows installs it automatically
#   2. Open: Settings → Bluetooth & devices → Printers & scanners
#   3. Click the printer → copy the name exactly (e.g. "CN811" or "Generic / Text Only")
PRINTER_NAME=CN811

# Linux/Mac: USB device file (usually /dev/usb/lp0 on Linux)
# Only needed if running on Linux or Mac instead of Windows
# PRINTER_DEV=/dev/usb/lp0

# ── Network mode (PRINTER_TYPE=network) ───────────────────────────────────────
# Only needed if your printer has Ethernet/Wi-Fi (not required for USB mode)
# PRINTER_IP=192.168.1.50
# PRINTER_PORT=9100

# ── Common settings ────────────────────────────────────────────────────────────
# Paper width in characters (80mm paper at default font = 42 chars)
PRINTER_CHARS_PER_LINE=42

# Printer station ID — leave as "default" for a single printer setup
PRINTER_STATION_ID=default

# Restaurant name printed on receipt header
RESTAURANT_NAME=Foodie Lover
